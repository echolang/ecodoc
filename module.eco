/*
 * ecodoc: a documentation site generator for Echo libraries.
 */

#[module: "ecodoc"]
#[version: "0.1.1"] // x-release-please-version

#[sources: "src/**/*.eco"]
#[cc: sources "c/*.c"]

#[requires: "echolang/libjson" { version: "^0.1", source: git "https://github.com/echolang/libjson" }]
#[requires: "echolang/libhttp" { version: "^0.2.6", source: git "https://github.com/echolang/libhttp" }]
#[requires: "echolang/libcommand" { version: "^0.1", source: git "https://github.com/echolang/libcommand" }]

#[target: exe { name: "ecodoc", entry: "main.eco" }] {
    #[sources: "main.eco"]
}

#[target: test] {
    #[sources: "tests/*.eco"]
}
