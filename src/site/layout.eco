namespace ecodoc::site;

use ecodoc::config::{Sidebar, SidebarItem, Site};
use ecodoc::text::{Ascii, Html};

/**
 * The theme's icons as inline SVG strings, drawn in `currentColor` so they
 * follow the text around them.
 *
 * I inlined them instead of shipping an icon font or a sprite file: one
 * less request, and an icon can't go missing when the site is served under a base path.
 */
public struct Icons
{
    /**
     * The magnifier in the search button.
     */
    public static function search() : string
    {
        return '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>';
    }

    /**
     * The sun on the theme toggle, shown in dark mode.
     */
    public static function sun() : string
    {
        return '<svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4"></path></svg>';
    }

    /**
     * The moon on the theme toggle, shown in light mode.
     */
    public static function moon() : string
    {
        return '<svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>';
    }

    /**
     * The repository link in the top bar.
     */
    public static function github() : string
    {
        return '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path></svg>';
    }

    /**
     * The sidebar button on narrow screens.
     */
    public static function menu() : string
    {
        return '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"></path></svg>';
    }

    /**
     * The fold arrow of a sidebar group. CSS rotates it when the group opens.
     */
    public static function chevron() : string
    {
        return '<svg class="chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>';
    }

    /**
     * In front of "Edit this page".
     */
    public static function pencil() : string
    {
        return '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>';
    }

    /**
     * The out-arrow on links that leave the site, like a source link.
     */
    public static function arrow() : string
    {
        return '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"></path></svg>';
    }

    /**
     * The Echo mark: a dot and three fading arcs.
     */
    public static function mark(int32 $size) : string
    {
        return "<svg width=\"{$size}\" height=\"{$size}\" viewBox=\"0 0 100 100\" fill=\"none\" aria-hidden=\"true\"><circle cx=\"35\" cy=\"50\" r=\"7.5\" fill=\"#008EFC\"></circle><path d=\"M 44 34.4 A 18 18 0 0 1 44 65.6\" stroke=\"#008EFC\" stroke-width=\"7\" stroke-linecap=\"round\"></path><path d=\"M 50 24 A 30 30 0 0 1 50 76\" stroke=\"#008EFC\" stroke-width=\"7\" stroke-linecap=\"round\" opacity=\"0.62\"></path><path d=\"M 56 13.6 A 42 42 0 0 1 56 86.4\" stroke=\"#008EFC\" stroke-width=\"7\" stroke-linecap=\"round\" opacity=\"0.3\"></path></svg>";
    }
}

/**
 * The chrome around every page: the top bar, the sidebar, the outline, the
 * footer and the pager. The markup follows the design one to one; the CSS
 * in `theme/ecodoc.css` styles it and `theme/js/` makes it move.
 *
 * Every page is a full HTML document with the chrome baked in. A link is a
 * page load, and any static host can serve the site. The scripts add search,
 * copy buttons and the theme toggle on top.
 */
public struct Layout
{
    /**
     * One complete HTML document, `<!doctype html>` to `</html>`.
     *
     * @param $site Title, nav, sidebars, theme, and base: the chrome every page shares.
     * @param $links Turns site paths into URLs under the base, for every link in the chrome.
     * @param $view This page's title, HTML, outline, and pager.
     */
    public static function render(const Site& $site, Links $links, PageView $view) : string
    {
        string $out = '';
        $out->reserve($view->main->size() + 16384);
        string $base = Html::escape($site->base);
        string $title = Html::escape(Layout::documentTitle($site, $view));
        string $description = Html::escape($view->description);
        string $lang = Html::escape($site->lang);
        string $theme = 'dark';
        if ($site->theme == 'light') {
            $theme = 'light';
        }

        $out->append("<!doctype html>\n<html lang=\"{$lang}\" class=\"theme-{$theme}\">\n<head>\n<meta charset=\"utf-8\">\n");
        $out->append("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n");
        $out->append("<title>{$title}</title>\n");
        if ($description->empty() == false) {
            $out->append("<meta name=\"description\" content=\"{$description}\">\n");
            $out->append("<meta property=\"og:description\" content=\"{$description}\">\n");
        }
        $out->append("<meta property=\"og:title\" content=\"{$title}\">\n");
        $out->append("<meta name=\"generator\" content=\"ecodoc\">\n");
        // the theme is settled before the first paint, so a light reader never sees the dark page flash
        string $default = Html::escape($site->theme);
        $out->append('<script>(function(){var d="');
        $out->append($default);
        $out->append('",t=null;try{t=localStorage.getItem("ecodoc-theme")}catch(e){}if(t!=="dark"&&t!=="light"){t=d==="auto"?(matchMedia("(prefers-color-scheme: light)").matches?"light":"dark"):d}document.documentElement.className="theme-"+t})()</script>');
        $out->append("\n");
        $out->append("<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n");
        $out->append("<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&amp;family=Instrument+Sans:wght@400;500;600;700&amp;display=swap\">\n");
        $out->append("<link rel=\"icon\" type=\"image/svg+xml\" href=\"{$base}assets/favicon.svg\">\n");
        $out->append("<link rel=\"stylesheet\" href=\"{$base}assets/ecodoc.css\">\n");
        $out->append("<script type=\"module\" src=\"{$base}assets/main.js\"></script>\n");
        $out->append("</head>\n");

        string $kind = 'doc';
        if ($view->layout == PageLayout::home) {
            $kind = 'home';
        } else if ($view->layout == PageLayout::page) {
            $kind = 'page';
        }
        string $url = Html::escape($view->url);
        $out->append("<body data-base=\"{$base}\" data-page=\"{$url}\" data-layout=\"{$kind}\">\n<div class=\"app\">\n");

        Layout::header($site, $links, $view, $out);

        Sidebar? $side = null;
        if ($view->sidebar) {
            $side = $site->sidebarFor($view->url);
        }
        bool $hasSide = $side != null;
        bool $hasToc = $view->outline;
        string $bodyCls = 'body';
        if ($hasSide == false) {
            $bodyCls->append(' no-side');
        }
        if ($hasToc == false) {
            $bodyCls->append(' no-toc');
        }
        $out->append("<div class=\"{$bodyCls}\">\n");

        if ($hasSide || $hasToc) {
            $out->append('<div class="localnav">');
            if ($hasSide) {
                $out->append("<button type=\"button\" class=\"menubtn\" data-menu aria-expanded=\"false\">");
                $out->append(Icons::menu());
                $out->append("Menu</button>");
            }
            $out->append('<span class="grow"></span>');
            if ($hasToc) {
                $out->append("<button type=\"button\" class=\"tocbtn\" data-toc-toggle aria-expanded=\"false\">On this page");
                $out->append(Icons::chevron());
                $out->append("</button>");
            }
            $out->append("</div>\n<button type=\"button\" class=\"scrim\" data-scrim aria-label=\"Close navigation\" tabindex=\"-1\"></button>\n");
        }

        if ($hasSide) {
            Layout::sidebar($side ?? Sidebar(), $links, $view->url, $out);
        }

        $out->append("<main class=\"main\" id=\"main\">\n");
        $out->append($view->main);
        Layout::pager($links, $view, $out);
        $out->append("</main>\n");

        if ($hasToc) {
            Layout::outline($view, $out);
        }
        $out->append("</div>\n");

        Layout::footer($site, $links, $out);
        $out->append("</div>\n</body>\n</html>\n");
        return $out;
    }

    private static function documentTitle(const Site& $site, PageView $view) : string
    {
        if ($view->title->empty() || $view->title == $site->title) {
            return $site->title->clone();
        }
        if ($site->title->empty()) {
            return $view->title->clone();
        }
        return "{$view->title} | {$site->title}";
    }

    private static function header(const Site& $site, Links $links, PageView $view, string& $out) : void
    {
        string $home = Html::escape($links->url('/'));
        string $name = Html::escape($site->title);
        $out->append("<header class=\"hdr\">\n<a class=\"brand\" href=\"{$home}\">");
        if ($site->logo->empty() == false) {
            string $logo = Html::escape($links->url(Route::rooted($site->logo)));
            $out->append("<img class=\"brand-logo\" src=\"{$logo}\" alt=\"\">");
        } else {
            $out->append("<span class=\"brand-tile\" aria-hidden=\"true\">");
            $out->append(Html::escape(Layout::initial($site->title)));
            $out->append("</span>");
        }
        string $sectionName = Html::escape($view->section);
        $out->append("<span class=\"brand-text\"><span class=\"brand-name\">{$name}</span><span class=\"brand-sub\">{$sectionName}</span></span></a>\n");
        if ($site->version->empty() == false) {
            string $v = Html::escape($site->version);
            $out->append("<span class=\"mono verchip\">{$v}</span>\n");
        }
        if ($site->nav->empty() == false) {
            $out->append('<nav class="nav" aria-label="Primary">');
            string $current = Layout::currentNav($site, $view->url);
            foreach ($site->nav as $n) {
                string $href = Html::escape($links->url($n->link));
                string $text = Html::escape($n->text);
                if ($n->link == $current) {
                    $out->append("<a href=\"{$href}\" aria-current=\"page\">{$text}</a>");
                } else if (Links::external($n->link)) {
                    $out->append("<a href=\"{$href}\" target=\"_blank\" rel=\"noreferrer\">{$text}</a>");
                } else {
                    $out->append("<a href=\"{$href}\">{$text}</a>");
                }
            }
            $out->append("</nav>\n");
        }
        $out->append('<div class="grow"></div>');
        $out->append("<button type=\"button\" class=\"search\" data-search aria-haspopup=\"dialog\">");
        $out->append(Icons::search());
        $out->append("<span class=\"search-label\">Search</span><kbd class=\"mono\">⌘K</kbd></button>");
        $out->append("<button type=\"button\" class=\"themebtn\" data-theme-toggle aria-label=\"Toggle dark mode\" title=\"Toggle dark mode\">");
        $out->append(Icons::sun());
        $out->append(Icons::moon());
        $out->append("</button>");
        if ($site->repo->empty() == false) {
            string $repo = Html::escape($site->repo);
            $out->append("<a class=\"repo\" href=\"{$repo}\" aria-label=\"Source repository\" target=\"_blank\" rel=\"noreferrer\">");
            $out->append(Icons::github());
            $out->append("</a>");
        }
        $out->append("\n</header>\n");
    }

    /**
     * The nav link that marks the current page: the one whose section is
     * the longest prefix of its URL.
     */
    private static function currentNav(const Site& $site, const string& $url) : string
    {
        string $best = '';
        usize $len = 0;
        foreach ($site->nav as $n) {
            if ($n->prefix->empty() || Links::external($n->link)) {
                continue;
            }
            bool $hit = $url->starts($n->prefix);
            if ($n->prefix == '/') {
                $hit = $url == '/';
            }
            if ($hit && $n->prefix->size() > $len) {
                $best = $n->link->clone();
                $len = $n->prefix->size();
            }
        }
        return $best;
    }

    /**
     * The letter in the logo spot of a site without `#[docs::logo:]`: the
     * first ASCII letter or digit of `$name`, uppercased. A name with no
     * letter or digit becomes `E`.
     *
     * ```echo
     * echo Layout::initial('libjson');  // L
     * echo Layout::initial('_ecodoc');  // E
     * echo Layout::initial('');         // E
     * ```
     */
    public static function initial(const string& $name) : string
    {
        for (usize $i = 0; $i < $name->size(); $i++) {
            uint8 $b = $name->byte($i);
            if (Ascii::upper($b) || Ascii::lower($b) || Ascii::digit($b)) {
                return str::upper($name->sub($i, 1));
            }
        }
        return 'E';
    }

    private static function sidebar(Sidebar $side, Links $links, const string& $url, string& $out) : void
    {
        $out->append("<aside class=\"side\" data-side aria-label=\"Sidebar\">\n<div class=\"side-inner\">\n");
        // loose links before the first group get a group of their own
        bool $openLoose = false;
        foreach ($side->items as $item) {
            if ($item->items->empty()) {
                if ($openLoose == false) {
                    $out->append('<div class="side-group">');
                    $openLoose = true;
                }
                Layout::sideLink($item, $links, $url, $out);
                continue;
            }
            if ($openLoose) {
                $out->append("</div>\n");
                $openLoose = false;
            }
            Layout::sideGroup($item, $links, $url, false, $out);
            $out->append("\n");
        }
        if ($openLoose) {
            $out->append("</div>\n");
        }
        $out->append("</div>\n</aside>\n");
    }

    /**
     * A group: its title, which folds it, then its entries. A nested group
     * (`md::` under `ecodoc::` in the reference) is drawn as a row like the
     * links around it and folds the same way.
     */
    private static function sideGroup(SidebarItem $item, Links $links, const string& $url, bool $nested, string& $out) : void
    {
        string $cls = 'side-group';
        string $title = 'side-title';
        if ($nested) {
            $cls->append(' side-sub');
            $title = 'side-link';
        }
        if ($item->kind->empty() == false) {
            $title->append(' mono');
        }
        string $expanded = 'true';
        if ($item->collapsed && Layout::contains($item, $url) == false) {
            $cls->append(' collapsed');
            $expanded = 'false';
        }
        $out->append("<div class=\"{$cls}\">");
        string $text = Html::escape($item->text);
        // the title is the toggle; a linked title keeps its link and gets a chevron button beside it
        if ($item->link->empty() == false) {
            $out->append('<div class="side-head">');
            if ($nested) {
                Layout::anchor($item, $title, $links, $url, $out);
            } else {
                string $href = Html::escape($links->url($item->link));
                string $current = '';
                if ($item->link == $url) {
                    $current = ' aria-current="page"';
                }
                $out->append("<a class=\"{$title}\" href=\"{$href}\"{$current}>{$text}</a>");
            }
            $out->append("<button type=\"button\" class=\"side-title side-chev\" data-side-toggle aria-expanded=\"{$expanded}\" aria-label=\"Show or hide {$text}\">");
            $out->append(Icons::chevron());
            $out->append('</button></div>');
        } else {
            $out->append("<button type=\"button\" class=\"{$title} side-toggle\" data-side-toggle aria-expanded=\"{$expanded}\"><span>{$text}</span>");
            $out->append(Icons::chevron());
            $out->append('</button>');
        }
        foreach ($item->items as $child) {
            Layout::sideLink($child, $links, $url, $out);
        }
        $out->append('</div>');
    }

    private static function sideLink(SidebarItem $item, Links $links, const string& $url, string& $out) : void
    {
        if ($item->items->empty() == false) {
            Layout::sideGroup($item, $links, $url, true, $out);
            return;
        }
        string $cls = 'side-link';
        if ($item->kind->empty() == false) {
            $cls->append(' mono');
        }
        if ($item->link->empty() == false) {
            Layout::anchor($item, $cls, $links, $url, $out);
        } else {
            string $text = Html::escape($item->text);
            $out->append("<span class=\"{$cls} label\">{$text}</span>");
        }
    }

    /**
     * A sidebar link: its text, and the dot when it is the current page.
     */
    private static function anchor(SidebarItem $item, const string& $cls, Links $links, const string& $url, string& $out) : void
    {
        string $href = Html::escape($links->url($item->link));
        string $text = Html::escape($item->text);
        if ($item->link == $url) {
            $out->append("<a class=\"{$cls}\" href=\"{$href}\" aria-current=\"page\"><span>{$text}</span><span class=\"dot\" aria-hidden=\"true\"></span></a>");
            return;
        }
        $out->append("<a class=\"{$cls}\" href=\"{$href}\"><span>{$text}</span></a>");
    }

    private static function contains(SidebarItem $item, const string& $url) : bool
    {
        if ($item->link == $url) {
            return true;
        }
        foreach ($item->items as $child) {
            if (Layout::contains($child, $url)) {
                return true;
            }
        }
        return false;
    }

    private static function outline(PageView $view, string& $out) : void
    {
        $out->append("<aside class=\"toc\" data-toc aria-label=\"On this page\">\n");
        if ($view->toc->empty() == false) {
            $out->append("<div class=\"toc-block\"><span class=\"eyebrow\">On this page</span>\n<nav class=\"toc-nav\" aria-label=\"Sections\"><span class=\"toc-rail\" aria-hidden=\"true\"></span><span class=\"toc-marker\" aria-hidden=\"true\"></span>\n");
            foreach ($view->toc as $g) {
                string $id = Html::escape($g->id);
                string $label = Html::escape($g->label);
                $out->append("<div class=\"toc-group\" data-group=\"{$id}\"><a class=\"toc-link\" href=\"#{$id}\" data-id=\"{$id}\">{$label}");
                if ($g->items->empty() == false) {
                    $out->append(Icons::chevron());
                }
                $out->append('</a>');
                if ($g->items->empty() == false) {
                    $out->append('<div class="tocsub">');
                    foreach ($g->items as $it) {
                        string $iid = Html::escape($it->id);
                        string $ilabel = Html::escape($it->label);
                        if ($it->kind->empty()) {
                            $out->append("<a class=\"toc-item\" href=\"#{$iid}\" data-id=\"{$iid}\">{$ilabel}</a>");
                        } else {
                            string $k = Html::escape($it->kind);
                            $out->append("<a class=\"toc-item mono\" href=\"#{$iid}\" data-id=\"{$iid}\"><span class=\"kind-letter k-{$k}\">{$k}</span>{$ilabel}</a>");
                        }
                    }
                    $out->append('</div>');
                }
                $out->append("</div>\n");
            }
            $out->append("</nav></div>\n");
        }
        if ($view->edit->empty() == false) {
            string $edit = Html::escape($view->edit);
            $out->append("<a class=\"edit\" href=\"{$edit}\" target=\"_blank\" rel=\"noreferrer\">");
            $out->append(Icons::pencil());
            $out->append("Edit this page</a>\n");
        }
        $out->append("</aside>\n");
    }

    private static function pager(Links $links, PageView $view, string& $out) : void
    {
        if ($view->prev->empty() && $view->next->empty()) {
            return;
        }
        $out->append('<nav class="pager" aria-label="Pagination">');
        if ($view->prev->empty() == false) {
            string $href = Html::escape($links->url($view->prev->link));
            string $text = Html::escape($view->prev->text);
            $out->append("<a class=\"pager-prev\" href=\"{$href}\"><span class=\"pager-dir\">← Previous</span><span class=\"pager-title\">{$text}</span></a>");
        } else {
            $out->append('<span></span>');
        }
        if ($view->next->empty() == false) {
            string $href = Html::escape($links->url($view->next->link));
            string $text = Html::escape($view->next->text);
            $out->append("<a class=\"pager-next\" href=\"{$href}\"><span class=\"pager-dir\">Next →</span><span class=\"pager-title\">{$text}</span></a>");
        }
        $out->append("</nav>\n");
    }

    private static function footer(const Site& $site, Links $links, string& $out) : void
    {
        string $name = Html::escape($site->title);
        $out->append("<footer class=\"ftr\"><div class=\"ftr-inner\">");
        $out->append("<span class=\"ftr-name\"><span class=\"ftr-title\">{$name}</span>");
        if ($site->version->empty() == false) {
            string $v = Html::escape($site->version);
            $out->append("<span class=\"mono ftr-version\">{$v}</span>");
        }
        $out->append('</span>');
        if ($site->footer->empty() == false || $site->copyright->empty() == false) {
            $out->append('<span class="ftr-message">');
            if ($site->footer->empty() == false) {
                $out->append(Html::escape($site->footer));
            }
            if ($site->copyright->empty() == false) {
                if ($site->footer->empty() == false) {
                    $out->append(' · ');
                }
                $out->append(Html::escape($site->copyright));
            }
            $out->append('</span>');
        }
        $out->append('<span class="grow"></span>');
        foreach ($site->nav as $n) {
            string $href = Html::escape($links->url($n->link));
            string $text = Html::escape($n->text);
            $out->append("<a class=\"ftr-link\" href=\"{$href}\">{$text}</a>");
        }
        if ($site->repo->empty() == false) {
            string $repo = Html::escape($site->repo);
            $out->append("<a class=\"ftr-link\" href=\"{$repo}\" target=\"_blank\" rel=\"noreferrer\">Source</a>");
        }
        $out->append("<a class=\"ftr-echo\" href=\"https://echoc.dev\" target=\"_blank\" rel=\"noreferrer\">");
        $out->append(Icons::mark(18));
        $out->append("Written in Echo</a>");
        $out->append("</div></footer>\n");
    }
}
